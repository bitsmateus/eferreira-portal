# ---------------------------------------------------------------------------
# Portal do Cliente — E. Ferreira Advogados
# Copie para .env e preencha. O .env NÃO vai para o repositório (regra 8).
# Em produção e homologação, cadastre cada valor como SECRETO no EasyPanel.
# ---------------------------------------------------------------------------

# Banco de dados (docker-compose sobe este Postgres em desenvolvimento)
DATABASE_URL="postgresql://eferreira:eferreira@localhost:5432/eferreira?schema=public"

# Auth.js v5
# Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Armazenamento de arquivos S3-compatível (MinIO em desenvolvimento).
# Regra 5: nenhum arquivo é público — tudo sai por URL pré-assinada curta.
ARMAZENAMENTO_ENDPOINT="http://localhost:9000"
ARMAZENAMENTO_REGIAO="us-east-1"
ARMAZENAMENTO_BALDE="eferreira-documentos"
ARMAZENAMENTO_CHAVE_ACESSO="eferreira"
ARMAZENAMENTO_CHAVE_SECRETA="eferreira123"
ARMAZENAMENTO_URL_VALIDADE_SEGUNDOS="300"

# Fuso de exibição e cálculo (regra 11)
FUSO_HORARIO="America/Sao_Paulo"

# Semente inicial — usada só pelo prisma/seed.ts
SEMENTE_ADMIN_EMAIL="admin@eferreiraadvogados.com.br"
SEMENTE_ADMIN_NOME="Administrador E. Ferreira"
SEMENTE_ADMIN_SENHA=""
SEMENTE_OPERADOR_EMAIL="operador@eferreiraadvogados.com.br"
SEMENTE_OPERADOR_NOME="Operador E. Ferreira"
SEMENTE_OPERADOR_SENHA=""

# Envio de e-mail (SMTP do escritório) — Anexo II, item 3.6.
# É por aqui que sai o código de acesso do cliente. Sem estas quatro
# variáveis, o código é impresso no terminal em desenvolvimento e o envio
# falha em produção. Marque SMTP_SENHA como secreta no EasyPanel (regra 8).
SMTP_SERVIDOR=""
SMTP_PORTA="587"
# "true" apenas para TLS implícito (porta 465). Em 587 o transporte usa STARTTLS.
SMTP_SEGURO="false"
SMTP_USUARIO=""
SMTP_SENHA=""
EMAIL_REMETENTE="Portal do Cliente — E. Ferreira Advogados <portal@eferreira.adv.br>"

# API do escritório (Anexo I, 3.b e 3.c).
# Define o prefixo das chaves geradas por esta instalação:
#   "producao"    -> ef_live_...
#   qualquer outro -> ef_test_...  (ambiente de testes)
# O padrão é o de testes de propósito: instalação mal configurada erra para o
# lado inofensivo. Chave de um ambiente não vale no outro.
AMBIENTE_DA_API="homologacao"
