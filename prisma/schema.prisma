// Portal do Cliente — E. Ferreira Advogados
// Regra 1: tudo em português. Regra 7: migrações versionadas, nunca "db push".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enumerações
// ---------------------------------------------------------------------------

enum PerfilUsuario {
  OPERADOR
  ADMINISTRADOR
  CLIENTE
}

enum SituacaoUsuario {
  ATIVO
  CONVITE_PENDENTE
  INATIVO
}

enum TipoPessoa {
  FISICA
  JURIDICA
}

/// "Excluir" cliente cadastrado por engano sem histórico continua apagando a
/// linha de vez (ver `excluirCliente`); isto aqui é para o outro caso — quem
/// já tem caso ou documento e não deveria mais estar na lista do dia a dia.
/// Mesmo padrão de `SituacaoUsuario`: desativar não apaga nada, só impede
/// login e sinaliza na tela. Pedido do escritório, item 4 da lista de
/// melhorias ("não há como remover cliente cadastrado por engano").
enum SituacaoCliente {
  ATIVO
  INATIVO
}

/// Situação do caso. Os dois valores vêm literalmente do protótipo aprovado
/// (telas "Ficha do cliente" e "Cliente — meus processos"). A lista de status
/// de ANDAMENTO é outra coisa: é configurável e depende do escritório
/// (Anexo II, item 3.5) — ver modelo StatusAndamento.
enum SituacaoCaso {
  EM_ANDAMENTO
  ARQUIVADO
}

/// Qual das cinco variações da cláusula de OBJETO do contrato vale para o caso —
/// "Objeto do contrato.docx", enviado pelo escritório em 21/09/2026. O texto de
/// cada uma vive em `src/modelos/contrato-objeto-*.html`.
enum TipoDeObjeto {
  CONSUMIDOR_PLANO_DE_SAUDE
  TRABALHISTA
  CIVEL
  REVISIONAL
  PERSONALIZADO
}

/// Como a remuneração personalizada se relaciona com as demais modalidades —
/// o trecho "[CUMULATIVA, SUBSTITUTIVA OU COMPENSAVEL]" da cláusula de
/// honorários personalizados.
enum NaturezaDoHonorarioPersonalizado {
  CUMULATIVA
  SUBSTITUTIVA
  COMPENSAVEL
}

/// Onde um documento está no caminho da assinatura eletrônica (D4Sign).
///
/// NO_COFRE existe por causa de uma falha possível e feia: o PDF sobe para o
/// cofre do escritório e o passo seguinte — a lista de signatários, ou o envio
/// — é recusado. O documento fica lá, e esta integração não apaga nada (pedido
/// expresso do escritório, 14/09/2026). Sem este estado, ele sumiria do sistema
/// e continuaria existindo no cofre, sem ninguém saber de onde veio.
enum SituacaoDoEnvio {
  NO_COFRE
  AGUARDANDO
  ASSINADO
  CANCELADO
}

enum TipoDocumento {
  CONTRATO
  PROCURACAO
  DECLARACAO
  ANEXO
}

/// De onde um `Documento` veio — item 5 da lista de melhorias ("'anexado por'
/// aparece em documento que o sistema gerou. Falta distinguir gerado de
/// anexado"). Note que isto é INDEPENDENTE de `tipo`: a tela de anexo permite
/// escolher tipo CONTRATO/PROCURAÇÃO/DECLARAÇÃO ao subir, por exemplo, um
/// contrato assinado em papel e digitalizado — esse documento tem
/// `tipo: CONTRATO` mas `origem: ANEXADO`, porque ninguém pediu pro sistema
/// gerar nada.
enum OrigemDoDocumento {
  /// Saiu de `gerarDocumento` — contrato, procuração ou declaração escritos
  /// pelo próprio sistema a partir dos modelos do escritório.
  GERADO
  /// Subiu pela tela de anexo (`anexarDocumento`) — de qualquer tipo.
  ANEXADO
  /// O PDF assinado que voltou da D4Sign (`arquivarAssinado`). Ninguém
  /// "anexou" nem "gerou" isto: a plataforma de assinatura devolveu.
  ASSINADO_NA_D4SIGN
}

/// O que uma credencial da API pode fazer (Anexo I, 3.c: "controle de
/// autenticação e de permissões de acesso à API").
///
/// São duas, e não três: o protótipo desenha também "Baixar documentos", mas o
/// item 3.b lista apenas consulta e cadastro/atualização. Endpoint de download
/// por API não existe, e permissão para endpoint que não existe é configuração
/// morta que engana quem lê a tela. Confirmar na demonstração.
enum PermissaoApi {
  CONSULTAR
  ESCREVER
}

/// As etiquetas do cadastro unificado de partes (abaixo). Não existe "CLIENTE"
/// aqui: cliente já tem cadastro próprio, com o vínculo Cliente/Caso — este
/// cadastro é só para quem fica de fora dele.
enum PapelDaParte {
  ADVOGADO
  PARTE_CONTRARIA
  TESTEMUNHA
  OUTROS
}

enum AcaoAuditoria {
  CRIACAO
  ATUALIZACAO
  EXCLUSAO
  ACESSO
  AUTENTICACAO
}

// ---------------------------------------------------------------------------
// Usuário — Anexo I, 1.b: acesso individual por e-mail e senha, perfis
// diferenciados. O usuário de perfil CLIENTE aponta para o Cliente que ele
// pode consultar; operador e administrador não apontam para nenhum.
// ---------------------------------------------------------------------------

model Usuario {
  id        String          @id @default(cuid())
  nome      String
  /// Obrigatório para OPERADOR e ADMINISTRADOR: é com ele que entram.
  ///
  /// NULO para o perfil CLIENTE, de propósito. O cliente entra por CPF/CNPJ e
  /// o código vai para `cliente.email` — repetir o endereço aqui criaria duas
  /// verdades que se desencontrariam assim que alguém corrigisse o cadastro.
  /// Além disso, dois clientes podem legitimamente compartilhar um e-mail
  /// (empresa e sócio, marido e mulher), e a unicidade desta coluna os
  /// impediria de existir. No Postgres, o índice único convive com NULOS.
  email     String?         @unique
  /// Argon2id. Nulo para o perfil CLIENTE, que entra por CPF/CNPJ + código
  /// enviado por e-mail (Anexo II, item 3.6 — resolvido).
  senhaHash String?
  perfil    PerfilUsuario
  situacao  SituacaoUsuario @default(ATIVO)

  /// Bloqueio após 5 tentativas erradas, por 15 minutos.
  tentativasFalhas Int       @default(0)
  bloqueadoAte     DateTime?
  ultimoAcessoEm   DateTime?

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Preenchido quando este usuário é o "autor" de uma credencial da API.
  credencialDaApi    CredencialApi?  @relation("UsuarioDaCredencial")
  credenciaisCriadas CredencialApi[] @relation("CredencialCriadaPor")

  clientesCadastrados        Cliente[]                   @relation("ClienteCriadoPor")
  casosResponsavel           Caso[]                      @relation("CasoResponsavel")
  andamentosLancados         Andamento[]                 @relation("AndamentoAutor")
  documentosEnviados         Documento[]                 @relation("DocumentoEnviadoPor")
  assinaturasPedidas         EnvioParaAssinatura[]       @relation("EnvioPedidoPor")
  partesCadastradas          Parte[]                     @relation("ParteCriadaPor")
  registrosAuditoria         Auditoria[]
  tokensDeRedefinicaoDeSenha TokenDeRedefinicaoDeSenha[]

  @@index([perfil])
  @@index([clienteId])
  @@map("usuario")
}

// ---------------------------------------------------------------------------
// Cliente — Anexo I, 1.e e 2.1: CPF ou CNPJ é a chave de identificação em
// todo o sistema. Guardado normalizado (só dígitos), exibido formatado.
// ---------------------------------------------------------------------------

model Cliente {
  id String @id @default(cuid())

  tipoPessoa TipoPessoa
  /// Só dígitos: 11 para CPF, 14 para CNPJ. Único no sistema inteiro — é o
  /// que garante o "reconhecimento" do passo 2 em vez de cadastro duplicado.
  documento  String     @unique
  nome       String
  /// `nome` em minúsculas e sem acento. É a coluna que a busca por nome
  /// consulta — ver normalizarParaBusca em src/lib/formatos.ts.
  nomeBusca  String

  // Qualificação (usada na geração da procuração e da declaração)
  rg             String?
  /// Nunca foi usada por nenhum modelo do escritório; o escritório confirmou
  /// em 14/09/2026 que sai da lista de obrigatórios. O campo fica porque há
  /// cadastro antigo com o dado preenchido.
  dataNascimento DateTime?
  estadoCivil    String?
  profissao      String?
  nacionalidade  String?
  /// Exigida pela procuração, pela declaração e pelo contrato — os três
  /// abrem com o mesmo bloco de qualificação. Anulável no banco porque não
  /// se aplica a pessoa jurídica: nesse caso ela mora no representante legal.
  nomeMae        String?

  // Contato — sem e-mail o cliente nunca consegue receber o código de acesso.
  email    String?
  telefone String?
  cep      String?
  /// Logradouro, número, complemento e bairro. A cidade vive à parte.
  endereco String?
  /// Cidade e UF separadas do resto do endereço porque não são só endereço:
  /// é delas que sai a CIDADE DA ASSINATURA dos documentos. O escritório
  /// definiu em 14/09/2026 que "o que define a cidade/estado da assinatura é
  /// o cadastro do cliente" — e o modelo novo da procuração confirma, com a
  /// sede do outorgante em São Paulo e o escritório em Mogi das Cruzes.
  cidade   String?
  uf       String?

  /// Gatilho do Anexo I, 1.d: o acesso do cliente só é liberado depois que o
  /// contrato foi assinado. Nulo = cliente não entra.
  contratoAssinadoEm DateTime?

  /// "Excluir" continua existindo para o cadastro vazio (`excluirCliente`,
  /// apaga a linha de vez). Isto é para quem já tem histórico e não deveria
  /// mais aparecer no dia a dia — desativa sem apagar nada, mesmo padrão de
  /// `SituacaoUsuario`. INATIVO bloqueia o código de acesso do portal do
  /// cliente (ver `clienteElegivel` em `acesso-do-cliente.ts`), com a MESMA
  /// resposta genérica de sempre — cliente inativo não pode ser distinguido
  /// de documento inexistente.
  situacao SituacaoCliente @default(ATIVO)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPorId String?
  criadoPor   Usuario? @relation("ClienteCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  casos           Caso[]
  documentos      Documento[]
  acessos         Usuario[]
  codigosDeAcesso CodigoDeAcesso[]

  /// Quando este cliente é pessoa jurídica: quem assina por ele.
  representantes        RepresentanteLegal[] @relation("RepresentadaPor")
  /// Quando este cliente é pessoa física: as empresas que ele representa.
  empresasQueRepresenta RepresentanteLegal[] @relation("Representa")

  @@index([nomeBusca])
  @@index([contratoAssinadoEm])
  @@map("cliente")
}

// ---------------------------------------------------------------------------
// Código de acesso do cliente — Anexo II, item 3.6 (resolvido): o cliente
// entra com CPF ou CNPJ e um código enviado ao e-mail do cadastro.
//
// O código NÃO é guardado em texto: quem tivesse leitura do banco entraria no
// lugar de qualquer cliente. Vale o mesmo Argon2id das senhas.
//
// Cada pedido gera uma linha nova; a anterior é invalidada. A linha sobrevive
// ao uso porque é ela que sustenta o limite de pedidos por cliente — e porque
// "quando este cliente pediu um código" é informação de auditoria.
// ---------------------------------------------------------------------------

model CodigoDeAcesso {
  id String @id @default(cuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Argon2id dos seis dígitos. Nunca o código em si.
  codigoHash String

  expiraEm     DateTime
  /// Tentativas erradas contra ESTE código. Na quinta, ele morre.
  tentativas   Int       @default(0)
  usadoEm      DateTime?
  /// Invalidado por um pedido mais novo, por tentativas demais ou por uso.
  invalidadoEm DateTime?

  enderecoIp    String?
  agenteUsuario String?

  criadoEm DateTime @default(now())

  @@index([clienteId, criadoEm])
  @@map("codigo_de_acesso")
}

// ---------------------------------------------------------------------------
// Token de redefinição de senha — "esqueci minha senha", para operador e
// administrador. Mesmo desenho do CodigoDeAcesso do cliente, mas ligado ao
// Usuario: seis dígitos por e-mail, em vez de link, para não ter dois padrões
// de recuperação no mesmo sistema.
//
// O código NÃO é guardado em texto, pelo mesmo motivo do código do cliente:
// quem tivesse leitura do banco poderia trocar a senha de qualquer um.
// ---------------------------------------------------------------------------

model TokenDeRedefinicaoDeSenha {
  id String @id @default(cuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Argon2id dos seis dígitos. Nunca o código em si.
  codigoHash String

  expiraEm     DateTime
  /// Tentativas erradas contra ESTE código. Na quinta, ele morre.
  tentativas   Int       @default(0)
  usadoEm      DateTime?
  /// Invalidado por um pedido mais novo, por tentativas demais ou por uso.
  invalidadoEm DateTime?

  enderecoIp    String?
  agenteUsuario String?

  criadoEm DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@map("token_de_redefinicao_de_senha")
}

// ---------------------------------------------------------------------------
// Representante legal — o "sócio" que o escritório pediu (14/09/2026).
//
// "Seria o mesmo cadastro da PF mas está ligado ao cadastro do PJ": o
// representante não é um bloco de campos dentro da empresa, é um Cliente
// pessoa física próprio, com a qualificação dele, ligado à pessoa jurídica.
// Assim ele pode ser cliente por conta própria e representar mais de uma
// empresa sem cadastro duplicado — que é a regra 4 aplicada a este caso.
//
// O termo de acordo enviado pelo escritório confirma o desenho: cada empresa
// aparece "neste ato representada por seu sócio", com nome, RG, CPF e
// endereço próprios.
// ---------------------------------------------------------------------------

model RepresentanteLegal {
  id String @id @default(cuid())

  pessoaJuridicaId String
  pessoaJuridica   Cliente @relation("RepresentadaPor", fields: [pessoaJuridicaId], references: [id], onDelete: Cascade)

  pessoaFisicaId String
  pessoaFisica   Cliente @relation("Representa", fields: [pessoaFisicaId], references: [id], onDelete: Cascade)

  /// Como consta no contrato social: "sócio", "sócio administrador",
  /// "presidente". Texto livre porque varia com o tipo de sociedade.
  qualificacao String?

  criadoEm DateTime @default(now())

  @@unique([pessoaJuridicaId, pessoaFisicaId])
  @@index([pessoaFisicaId])
  @@map("representante_legal")
}

// ---------------------------------------------------------------------------
// Caso — Anexo I, 2.2: um cliente, vários casos, cada um com identificação
// própria e o respectivo número de processo.
// ---------------------------------------------------------------------------

model Caso {
  id String @id @default(cuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Pode ser nulo: o protótipo prevê "casos sem número de processo — ainda em
  /// fase pré-processual".
  numeroProcesso String?      @unique
  assunto        String
  vara           String?
  parteContraria String?
  situacao       SituacaoCaso @default(EM_ANDAMENTO)

  responsavelId String?
  responsavel   Usuario? @relation("CasoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  /// Honorários contratados, em centavos — a cláusula 2ª do contrato precisa
  /// deles para ser gerada. Centavos, e não decimal, para não haver erro de
  /// arredondamento em valor que vai para documento assinado.
  ///
  /// ATENÇÃO (regra 12): isto é dado do contrato, NÃO é módulo financeiro. O
  /// escritório foi explícito em 14/09/2026: "nada vinculado referente a
  /// pagamentos, somente a adicionar". Não existe — e não deve passar a
  /// existir — baixa de parcela, situação de pagamento, inadimplência nem
  /// relatório financeiro. Se parecer necessário, pare e avise.
  ///
  /// É a modalidade "fixo" das quatro combinadas em 17/09/2026 — à vista
  /// (sem `parcelas`) ou parcelado (com `parcelas`). Convive com as duas de
  /// baixo: um caso pode ter fixo, êxito, proveito econômico, ou as três.
  honorariosEmCentavos Int?

  /// Honorários de êxito: percentual de 10 a 30, devido só ao final da
  /// demanda, sem entrada nem parcela — pedido do escritório em 17/09/2026. O
  /// texto da cláusula chegou em 21/09/2026 ("honorarios do contrato.docx").
  percentualExito Int?

  /// Percentual sobre o proveito econômico obtido — de 10 a 30. É o bloco
  /// "honorários proveito econômico" do escritório, que além do percentual
  /// pede os dois campos abaixo.
  percentualProveitoEconomico Int?

  /// "[IDENTIFICACAO_DA_OBRIGACAO, VALOR_DISCUTIDO_E_DATA_BASE]" — texto livre
  /// que o escritório escreve caso a caso: qual obrigação, qual valor
  /// discutido e a data-base da comparação.
  referenciaDaEconomia String? @db.Text

  /// "[PRAZO_PAGAMENTO]" — em dias, depois da apuração da economia.
  prazoDePagamentoDaEconomia Int?

  /// Qual das cinco variações da cláusula de objeto o contrato usa, e a
  /// descrição da demanda que entra no lugar de "[DESCREVER A DEMANDA...]".
  /// Nulos em caso antigo: o contrato só sai com os dois preenchidos.
  tipoDeObjeto      TipoDeObjeto?
  descricaoDoObjeto String?       @db.Text

  /// Honorários personalizados (bloco 4). Quando verdadeiro, os oito campos
  /// abaixo preenchem os marcadores da cláusula. Texto livre porque o
  /// escritório descreve, caso a caso, uma remuneração que não cabe nas outras
  /// três — o contrato só sai com todos preenchidos.
  honorariosPersonalizados             Boolean                           @default(false)
  personalizadoServicos                String?                           @db.Text
  personalizadoValorOuPercentual       String?                           @db.Text
  personalizadoBaseDeCalculo           String?                           @db.Text
  personalizadoCondicaoDeExigibilidade String?                           @db.Text
  personalizadoPagamento               String?                           @db.Text
  personalizadoNatureza                NaturezaDoHonorarioPersonalizado?
  personalizadoRelacaoComAsDemais      String?                           @db.Text
  personalizadoCondicoesEspecificas    String?                           @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  andamentos Andamento[]
  documentos Documento[]
  parcelas   ParcelaDeHonorarios[]

  @@index([clienteId])
  @@index([situacao])
  @@map("caso")
}

// ---------------------------------------------------------------------------
// Parcela dos honorários — só para escrever a cláusula de pagamento do
// contrato. Repare no que NÃO existe aqui: situação de pagamento, data de
// quitação, comprovante. É de propósito (regra 12) — o módulo financeiro está
// fora do contrato, e o escritório confirmou que quer apenas registrar.
// ---------------------------------------------------------------------------

model ParcelaDeHonorarios {
  id String @id @default(cuid())

  casoId String
  caso   Caso   @relation(fields: [casoId], references: [id], onDelete: Cascade)

  /// 1 para a primeira, 2 para a segunda. É a ordem em que sai no contrato.
  numero          Int
  valorEmCentavos Int
  /// Dia civil do vencimento, ancorado ao meio-dia UTC (regra 11).
  vencimento      DateTime

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([casoId, numero])
  @@index([casoId])
  @@map("parcela_de_honorarios")
}

// ---------------------------------------------------------------------------
// Status de andamento — lista CONFIGURÁVEL. O conteúdo dela é dependência do
// escritório (Anexo II, item 3.5) e trava a Sprint 2. A tabela nasce vazia de
// propósito: não se inventa lista de status.
// ---------------------------------------------------------------------------

model StatusAndamento {
  id    String  @id @default(cuid())
  nome  String  @unique
  ordem Int     @default(0)
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  andamentos Andamento[]

  @@map("status_andamento")
}

// ---------------------------------------------------------------------------
// Andamento — Anexo I, 2.4: com data e histórico, e sempre com autor
// identificado (regra 6).
// ---------------------------------------------------------------------------

model Andamento {
  id String @id @default(cuid())

  casoId String
  caso   Caso   @relation(fields: [casoId], references: [id], onDelete: Cascade)

  /// Data do fato processual, em UTC. Exibida em America/Sao_Paulo (regra 11).
  data DateTime

  statusId String?
  status   StatusAndamento? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  /// Texto que o cliente lê na área de consulta.
  descricao String

  autorId String
  autor   Usuario @relation("AndamentoAutor", fields: [autorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([casoId, data])
  @@map("andamento")
}

// ---------------------------------------------------------------------------
// Documento — Anexo I, 4.a: pasta única por cliente. O arquivo em si vive no
// object storage; aqui fica só a chave. Regra 5: a chave nunca é adivinhável e
// nunca é servida direto.
// ---------------------------------------------------------------------------

model Documento {
  id String @id @default(cuid())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  /// Nulo quando o documento é do cliente e não de um caso específico
  /// (contrato, procuração, declaração, RG).
  casoId String?
  caso   Caso?   @relation(fields: [casoId], references: [id], onDelete: SetNull)

  tipo         TipoDocumento
  /// De onde este documento veio — ver o comentário grande no enum, acima.
  /// Backfill dos registros anteriores a esta coluna: ASSINADO_NA_D4SIGN para
  /// quem já era o alvo de um envio (`documentoAssinadoId`), GERADO para o
  /// resto com tipo diferente de ANEXO, ANEXADO para o resto. Não é garantia
  /// perfeita para dado antigo (um contrato em papel digitalizado antes desta
  /// coluna existir ficaria classificado como GERADO), mas é a melhor
  /// inferência possível sem ter guardado a origem desde o início.
  origem       OrigemDoDocumento @default(ANEXADO)
  nome         String
  /// Chave no object storage. Opaca, gerada pelo servidor.
  chaveArquivo String            @unique
  tipoConteudo String
  tamanhoBytes Int

  assinadoEm DateTime?

  enviadoPorId String?
  enviadoPor   Usuario? @relation("DocumentoEnviadoPor", fields: [enviadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Envios deste documento para assinatura. Plural porque uma tentativa
  /// recusada não apaga a anterior — o histórico é parte do rastro (regra 6).
  envios EnvioParaAssinatura[] @relation("DocumentoEnviado")

  /// Preenchido quando ESTE documento é o PDF assinado que voltou da D4Sign.
  origemDaAssinatura EnvioParaAssinatura? @relation("DocumentoAssinado")

  @@index([clienteId])
  @@index([casoId])
  @@map("documento")
}

// ---------------------------------------------------------------------------
// Credencial da API — Anexo I, itens 3.b e 3.c.
//
// A chave tem a forma `ef_live_<identificador>_<segredo>`. O identificador é
// público e indexado: é por ele que a requisição acha a linha em uma consulta
// só. O segredo nunca é guardado — só o hash dele.
//
// SHA-256, e não Argon2id, de propósito. Argon2 existe para segredo escolhido
// por gente, que é curto e previsível; aqui o segredo são 192 bits sorteados
// por CSPRNG, que não se quebra por força bruta. E um hash lento rodando em
// toda requisição de API seria, ele próprio, o jeito de derrubar o serviço.
// ---------------------------------------------------------------------------

model CredencialApi {
  id String @id @default(cuid())

  /// Como o escritório chama esta chave: "Site institucional", "Integração X".
  nome String

  /// `ef_live_` em produção, `ef_test_` no ambiente de testes. Ver
  /// AMBIENTE_DA_API em .env.example e docs/api.md.
  prefixo String

  /// Parte pública da chave. É o que a requisição usa para localizar a linha.
  identificador String @unique

  /// SHA-256 do segredo, comparado em tempo constante.
  segredoHash String

  /// Últimos quatro caracteres, só para alguém reconhecer a chave na lista.
  final String

  permissoes PermissaoApi[]

  /// Nulo = ativa. A chave nunca é apagada: o histórico de auditoria aponta
  /// para ela e precisa continuar dizendo quem fez o quê.
  revogadoEm DateTime?

  ultimoUsoEm DateTime?

  /// O usuário em nome de quem a API escreve.
  ///
  /// Andamento exige autor (regra 6) e `autorId` é chave estrangeira — uma
  /// chave de API sem usuário próprio não teria como lançar andamento sem
  /// mentir sobre quem lançou. Este usuário não tem e-mail nem senha, então
  /// não entra por tela nenhuma.
  usuarioId String  @unique
  usuario   Usuario @relation("UsuarioDaCredencial", fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoPorId String?
  criadoPor   Usuario? @relation("CredencialCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([revogadoEm])
  @@map("credencial_api")
}

// ---------------------------------------------------------------------------
// Envio para assinatura eletrônica — Anexo II, item 3.4 (resolvido: D4Sign).
//
// Um documento gerado que foi para a plataforma de assinatura. Guardar isto no
// banco não é conveniência: sem o `uuidDocumento`, o portal não tem como
// perguntar depois se aquele documento já foi assinado, e o PDF assinado nunca
// voltaria para a pasta do cliente.
//
// CADA LINHA AQUI CUSTOU UM CRÉDITO do escritório (Cláusula 6ª) e disparou
// e-mail de verdade. Não existe ensaio: por isso o envio é um passo explícito,
// com tela de confirmação, e nunca um efeito colateral da geração do PDF.
// ---------------------------------------------------------------------------

model EnvioParaAssinatura {
  id String @id @default(cuid())

  /// O documento gerado que foi enviado — o PDF sem assinatura.
  documentoId String
  documento   Documento @relation("DocumentoEnviado", fields: [documentoId], references: [id], onDelete: Cascade)

  /// O identificador do documento dentro da D4Sign. É por ele que se pergunta
  /// se já assinaram e é por ele que se baixa o assinado.
  uuidDocumento String @unique
  /// O cofre em que ele foi criado, guardado junto: a variável de ambiente
  /// pode mudar, e depois ninguém saberia onde este documento foi parar.
  cofre         String

  situacao         SituacaoDoEnvio @default(NO_COFRE)
  /// O texto cru que a D4Sign devolveu na última consulta. Guardado porque a
  /// tradução para `situacao` é nossa, e situação nova deles não pode virar
  /// informação perdida.
  situacaoNaD4Sign String?

  /// Preenchido assim que a D4Sign confirma o cadastro dos signatários
  /// (createlist). Tentar de novo depois de uma falha em `mandarAssinar` NÃO
  /// pode repetir esse passo: createlist não é idempotente na D4Sign — cada
  /// chamada ACRESCENTA signatários, nunca substitui os que já existem. Sem
  /// este campo, um retry recriava a lista inteira e o documento ficava com
  /// sósias do mesmo signatário, alguns "sem conta" que ninguém jamais
  /// completaria — e o envio nunca fechava 100% na D4Sign.
  signatariosDefinidosEm DateTime?

  /// Para quem o e-mail de assinatura foi, com nome e papel. É a resposta à
  /// pergunta "para qual endereço isto foi?", feita sempre depois do envio.
  signatarios Json

  enviadoEm   DateTime?
  conferidoEm DateTime?
  assinadoEm  DateTime?

  /// O PDF assinado, já arquivado na pasta do cliente. Nulo enquanto não
  /// voltar. O documento original continua existindo, ao lado deste.
  documentoAssinadoId String?    @unique
  documentoAssinado   Documento? @relation("DocumentoAssinado", fields: [documentoAssinadoId], references: [id], onDelete: SetNull)

  pedidoPorId String?
  pedidoPor   Usuario? @relation("EnvioPedidoPor", fields: [pedidoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([documentoId])
  @@index([situacao])
  @@map("envio_para_assinatura")
}

// ---------------------------------------------------------------------------
// Parte — cadastro unificado para quem assina um documento AVULSO sem ser
// cliente do escritório (reunião de 17/09/2026): parte contrária, testemunha,
// advogado externo ou outro papel livre.
//
// De propósito, uma tabela PRÓPRIA, sem nenhuma ligação com `Cliente`: o
// escritório foi explícito — "eu não sei se vai ser cliente ou não, é
// informação transitória, não quero contaminar meu banco de dados principal
// de clientes". A mesma pessoa pode um dia aparecer nos dois cadastros, sem
// vínculo automático entre eles.
//
// Não guarda documento (CPF/CNPJ) nem endereço: só o que a D4Sign precisa
// para mandar o e-mail de assinatura. Quem de fato assinou um envio fica
// gravado em `EnvioParaAssinatura.signatarios` (JSON, um retrato daquele
// momento) — apagar ou editar uma `Parte` depois não muda o que já foi
// enviado, do mesmo jeito que editar um `Cliente` não reescreve andamento
// já lançado.
// ---------------------------------------------------------------------------

model Parte {
  id String @id @default(cuid())

  nome     String
  email    String
  telefone String?
  papel    PapelDaParte

  /// Texto livre: "advogado da parte contrária no caso X", "testemunha do
  /// acordo Y". Não entra em nenhum documento — é só para quem cadastra
  /// lembrar depois quem é quem.
  observacoes String?

  criadoPorId String?
  criadoPor   Usuario? @relation("ParteCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([papel])
  @@index([nome])
  @@map("parte")
}

// ---------------------------------------------------------------------------
// Auditoria — regra 6: quem fez, o quê, quando e sobre qual registro.
// ---------------------------------------------------------------------------

model Auditoria {
  id String @id @default(cuid())

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  /// Guardado em texto também, para o registro sobreviver à exclusão do usuário.
  usuarioEmail String?

  acao       AcaoAuditoria
  entidade   String
  entidadeId String?

  detalhes Json?

  enderecoIp    String?
  agenteUsuario String?

  criadoEm DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([criadoEm])
  @@map("auditoria")
}
